# Kitty 环境配置
# 当前项目的本地凭证、Provider 预设、远程渠道与运行参数。

# 智能体配置
# 界面语言：zh-CN、en、ja、ko
KITTY_LOCALE=zh-CN
KITTY_PROFILE=intp

# 当前语言模型 Provider
# 切换 Provider 时，需要同时替换对应的 KITTY_API_KEY。
# RPM、TPM、RPD 由 Provider 项目动态决定；运行时遵守 Retry-After 和 Provider quota facts，不在 env 硬编码。
# Provider 预设：Agnes AI｜Agnes 2.0 Flash｜免费｜稳定
# 思考：enabled/disabled；此模型不使用推理强度，留空即可。
KITTY_PROVIDER=agnes
KITTY_API_KEY=replace-with-your-provider-key
KITTY_BASE_URL=https://apihub.agnes-ai.com/v1
KITTY_MODEL=agnes-2.0-flash
KITTY_THINKING=enabled
KITTY_REASONING_EFFORT=

# 其他 Provider 预设
# Provider 预设：Agnes AI｜Agnes 2.5 Flash｜免费｜灰度
# 思考：enabled/disabled；此模型不使用推理强度，留空即可。
# KITTY_PROVIDER=agnes
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://apihub.agnes-ai.com/v1
# KITTY_MODEL=agnes-2.5-flash
# KITTY_THINKING=enabled
# KITTY_REASONING_EFFORT=

# Provider 预设：Google Gemini｜Gemini 3.5 Flash｜免费｜1M 上下文
# Gemini 3.5 思考始终开启；推理强度：minimal/low/medium/high。
# KITTY_PROVIDER=google
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KITTY_MODEL=gemini-3.5-flash
# KITTY_THINKING=enabled
# KITTY_REASONING_EFFORT=medium

# Provider 预设：DeepSeek official V4
# 思考：enabled/disabled；推理强度：high 常规，max 更充分但通常更慢。
