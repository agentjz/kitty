# Kitty environment
# Local credentials, provider presets, Telegram, and runtime configuration for this project.

# Agent profile
# Locale: zh-CN, en, ja, ko
KITTY_LOCALE=zh-CN
KITTY_PROFILE=intp

# Active provider
# Switching providers requires replacing KITTY_API_KEY before saving.
# Provider preset: Agnes AI + 2.0 Flash
KITTY_PROVIDER=agnes
KITTY_API_KEY=replace-with-your-provider-key
KITTY_BASE_URL=https://apihub.agnes-ai.com/v1
KITTY_MODEL=agnes-2.0-flash
KITTY_THINKING=enabled
KITTY_REASONING_EFFORT=high

# Alternative provider presets
# Provider preset: NVIDIA NIM + DeepSeek V4 Flash
# KITTY_PROVIDER=nvidia
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://integrate.api.nvidia.com/v1
# KITTY_MODEL=deepseek-ai/deepseek-v4-flash
# KITTY_THINKING=enabled
# KITTY_REASONING_EFFORT=high

# Provider preset: Gemini + 2.5 Flash
# KITTY_PROVIDER=gemini
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# KITTY_MODEL=gemini-2.5-flash
# KITTY_THINKING=disabled
# KITTY_REASONING_EFFORT=high

# Provider preset: YLS Codex + GPT-5.4
# KITTY_PROVIDER=yls
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://code.ylsagi.com/codex
# KITTY_MODEL=gpt-5.4
# KITTY_THINKING=enabled
# KITTY_REASONING_EFFORT=xhigh

# Provider preset: TTAPI + GPT-5.4
# KITTY_PROVIDER=ttapi
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://w.ciykj.cn
# KITTY_MODEL=gpt-5.4
# KITTY_THINKING=disabled
# KITTY_REASONING_EFFORT=xhigh

# Provider preset: DeepSeek official V4
# KITTY_PROVIDER=deepseek
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=https://api.deepseek.com
# KITTY_MODEL=deepseek-v4-flash
# KITTY_THINKING=enabled
# KITTY_REASONING_EFFORT=high

# Provider preset: 本机 + Google Gemma 3 12B
# KITTY_PROVIDER=llama.cpp
# KITTY_API_KEY=replace-with-your-provider-key
# KITTY_BASE_URL=http://127.0.0.1:8080/v1
# KITTY_MODEL=gemma-3-12b-it-q4_0.gguf
# KITTY_THINKING=disabled
# KITTY_REASONING_EFFORT=

# Weixin iLink private chat
KITTY_WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
KITTY_WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
KITTY_WEIXIN_ALLOWED_USER_IDS=
KITTY_WEIXIN_POLLING_TIMEOUT_MS=30000
KITTY_WEIXIN_POLLING_RETRY_BACKOFF_MS=1000
KITTY_WEIXIN_MESSAGE_CHUNK_BYTES=3500
KITTY_WEIXIN_TYPING_INTERVAL_MS=4000
KITTY_WEIXIN_QR_TIMEOUT_MS=480000
KITTY_WEIXIN_ROUTE_TAG=

# Telegram private chat
KITTY_TELEGRAM_TOKEN=
KITTY_TELEGRAM_ALLOWED_USER_IDS=
KITTY_TELEGRAM_API_BASE_URL=https://api.telegram.org
KITTY_TELEGRAM_PROXY_URL=
KITTY_TELEGRAM_POLLING_TIMEOUT_SECONDS=50
KITTY_TELEGRAM_POLLING_LIMIT=100
KITTY_TELEGRAM_POLLING_RETRY_BACKOFF_MS=1000
KITTY_TELEGRAM_MESSAGE_CHUNK_CHARS=3500
KITTY_TELEGRAM_TYPING_INTERVAL_MS=4000
KITTY_TELEGRAM_DELIVERY_MAX_RETRIES=6
KITTY_TELEGRAM_DELIVERY_BASE_DELAY_MS=1000
KITTY_TELEGRAM_DELIVERY_MAX_DELAY_MS=30000

# Extension switches
KITTY_EXTENSION_TODO=true
KITTY_EXTENSION_SCHEDULER=true
KITTY_EXTENSION_WORKTREE=true
KITTY_EXTENSION_NETWORK=true
KITTY_EXTENSION_BACKGROUND=true
KITTY_EXTENSION_DOCUMENTS=true
KITTY_EXTENSION_MEDIA=true
KITTY_EXTENSION_SKILLS=true

# Runtime configuration
KITTY_MAX_OUTPUT_TOKENS=384000
KITTY_CONTEXT_WINDOW_MESSAGES=120
KITTY_MAX_CONTEXT_CHARS=900000
KITTY_CONTEXT_SUMMARY_CHARS=120000
KITTY_MAX_READ_BYTES=120000
KITTY_PROJECT_DOC_MAX_BYTES=24576
KITTY_COMMAND_STALL_TIMEOUT_MS=30000
KITTY_SHOW_REASONING=true

# Image and video generation
KITTY_MEDIA_PROVIDER=agnes
KITTY_MEDIA_BASE_URL=https://apihub.agnes-ai.com/v1
KITTY_MEDIA_API_KEY=replace-with-your-agnes-key
KITTY_MEDIA_IMAGE_MODEL=agnes-image-2.1-flash
KITTY_MEDIA_VIDEO_MODEL=agnes-video-v2.0
KITTY_MEDIA_REQUEST_TIMEOUT_MS=600000
KITTY_MEDIA_POLL_INTERVAL_MS=15000
